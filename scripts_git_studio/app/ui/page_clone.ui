<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PageClone</class>
 <widget class="QWidget" name="PageClone">
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QLabel" name="lblTitle">
     <property name="text"><string>Clonar</string></property>
     <property name="styleSheet"><string>font-size: 18px; font-weight: bold;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lblSubtitle">
     <property name="text"><string>Descarga de repositorios de GitHub con control de profundidad de commits</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="userRow">
     <item>
      <widget class="QLabel" name="lblUser">
       <property name="text"><string>Usuario/organización:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="editUser"/>
     </item>
     <item>
      <widget class="QLabel" name="lblToken">
       <property name="text"><string>Token (opcional):</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="editToken">
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
       <property name="placeholderText"><string>variable GITHUB_TOKEN si está definida</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnFetchList">
       <property name="text"><string>Consultar repos (API)</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="mainRow">
     <item>
      <widget class="QGroupBox" name="groupRemote">
       <property name="title"><string>Repositorios remotos (marca los que quieras clonar)</string></property>
       <layout class="QVBoxLayout" name="remoteLayout">
        <item>
         <widget class="QListWidget" name="listRemote">
          <property name="alternatingRowColors"><bool>true</bool></property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="remoteButtons">
          <item>
           <widget class="QPushButton" name="btnMarkAll">
            <property name="text"><string>Todos</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnMarkNone">
            <property name="text"><string>Ninguno</string></property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="chkIncludeForks">
            <property name="text"><string>Incluir forks</string></property>
           </widget>
          </item>
          <item>
           <spacer name="remoteSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupOptions">
       <property name="title"><string>Opciones de clonado</string></property>
       <layout class="QFormLayout" name="optionsForm">
        <item row="0" column="0">
         <widget class="QLabel" name="lblDest">
          <property name="text"><string>Carpeta destino:</string></property>
         </widget>
        </item>
        <item row="0" column="1">
         <layout class="QHBoxLayout" name="destRow">
          <item>
           <widget class="QLineEdit" name="editDest"/>
          </item>
          <item>
           <widget class="QPushButton" name="btnBrowseDest">
            <property name="text"><string>Examinar…</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lblDepth">
          <property name="text"><string>Profundidad:</string></property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="comboDepth">
          <property name="editable"><bool>true</bool></property>
          <property name="toolTip"><string>1 = solo último commit · N = últimos N · full = historial completo</string></property>
          <item><property name="text"><string>1</string></property></item>
          <item><property name="text"><string>5</string></property></item>
          <item><property name="text"><string>full</string></property></item>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="lblProtocol">
          <property name="text"><string>Protocolo:</string></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboProtocol">
          <item><property name="text"><string>ssh</string></property></item>
          <item><property name="text"><string>https</string></property></item>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="lblBranch">
          <property name="text"><string>Rama (opcional):</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QLineEdit" name="editBranch">
          <property name="placeholderText"><string>rama por defecto del repo</string></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="lblExclude">
          <property name="text"><string>Excluir (coma):</string></property>
         </widget>
        </item>
        <item row="4" column="1">
         <widget class="QLineEdit" name="editExclude">
          <property name="placeholderText"><string>repo1, repo2</string></property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="QCheckBox" name="chkStripGit">
          <property name="text"><string>Snapshot sin carpeta .git</string></property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="QCheckBox" name="chkDryRun">
          <property name="text"><string>Dry-run (simular sin clonar)</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="QCheckBox" name="chkRegister">
          <property name="text"><string>Registrar clonados en repos-config.yml</string></property>
          <property name="toolTip"><string>Los repos clonados quedan disponibles para Sincronizar y Estado</string></property>
         </widget>
        </item>
        <item row="8" column="1">
         <widget class="QPushButton" name="btnClone">
          <property name="text"><string>Clonar seleccionados</string></property>
          <property name="minimumHeight"><number>36</number></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="lblSummary">
     <property name="text"><string>—</string></property>
    </widget>
   </item>
  </layout>
