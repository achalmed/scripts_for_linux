/* Tema claro de Filesystem Studio */

QWidget {
    background-color: #f5f6f8;
    color: #24292f;
    font-size: 13px;
}

QListWidget#sidebar {
    background-color: #e9ebef;
    border: none;
    padding-top: 8px;
    outline: none;
}
QListWidget#sidebar::item {
    padding: 10px 14px;
    border-left: 3px solid transparent;
    color: #44505f;
}
QListWidget#sidebar::item:hover { background-color: #dde1e7; }
QListWidget#sidebar::item:selected {
    background-color: #d3dced;
    border-left: 3px solid #2f6fdb;
    color: #16324f;
}

QGroupBox {
    border: 1px solid #d0d5dc;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #57606a;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d5dc;
    border-radius: 4px;
    padding: 4px 6px;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QComboBox:focus { border-color: #2f6fdb; }

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c4cad2;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: #eef1f5; }
QPushButton:pressed { background-color: #2f6fdb; color: #ffffff; }
QPushButton:disabled { color: #9aa4b0; background-color: #eceef1; }

QTreeView, QTableView, QListWidget, QTreeWidget {
    background-color: #ffffff;
    alternate-background-color: #f2f4f7;
    border: 1px solid #d0d5dc;
    border-radius: 4px;
}
QHeaderView::section {
    background-color: #e9ebef;
    border: none;
    border-right: 1px solid #d0d5dc;
    padding: 5px 8px;
    color: #57606a;
}

QTabWidget::pane { border: 1px solid #d0d5dc; border-radius: 4px; }
QTabBar::tab {
    background-color: #e9ebef;
    padding: 6px 16px;
    border: 1px solid #d0d5dc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected { background-color: #ffffff; }

QProgressBar {
    background-color: #ffffff;
    border: 1px solid #d0d5dc;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk { background-color: #2f6fdb; border-radius: 3px; }

QStatusBar { background-color: #e9ebef; color: #57606a; }
QDockWidget::title { background-color: #e9ebef; padding: 5px 10px; }
QSplitter::handle { background-color: #d0d5dc; }
