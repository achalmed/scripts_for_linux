# scripts_for_linux/.gitignore — comentado por clase (NORMATIVA §5 y §15.8): lo interno no convive con lo listado.
# Cubre también las dos GUI y sus backends: los patrones sin barra inicial valen en cualquier carpeta.

# --- temporal: bytecode y cachés de herramientas Python ---------------------
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- temporal: entornos virtuales y variables locales (nunca en git) --------
.venv/
venv/
.env

# --- artefacto de construcción: recursos Qt compilados ----------------------
# lo regenera scripts_filesystem_studio/tools/build_resources.sh
resources_rc.py

# --- temporal: informes de ejecución y logs (rotan en cada corrida) ---------
reports/
*.log

# --- derivado: árboles que escribe script_proyect_tree (D07) ----------------
estructura.txt

# --- temporal: lista de trabajo local de script_hardlinks-creator -----------
script_hardlinks-creator/archivos.txt

# --- ajustes locales del asistente ------------------------------------------
.claude/
