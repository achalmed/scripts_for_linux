# scripts-linux/.gitignore — comentado por clase (NORMATIVA §5 y §15.8): lo interno no convive con lo listado.
# Los patrones sin barra inicial valen en cualquier carpeta (las GUI viven en el repo studios desde la ola 4).

# --- temporal: bytecode y cachés de herramientas Python ---------------------
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- temporal: entornos virtuales y variables locales (nunca en git) --------
.venv/
venv/
.env

# --- temporal: informes de ejecución y logs (rotan en cada corrida) ---------
reports/
*.log


# --- ajustes locales del asistente ------------------------------------------
.claude/

# --- derivado: el .zip del plugin de Super Productivity (main.py plugin --aplicar lo arma desde plugin-sp/) ---
script_registro_tiempo/dist/
