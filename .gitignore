# scripts_for_linux/.gitignore — comentado por clase (NORMATIVA §5 y §15.8): lo interno no convive con lo listado.

# --- Bytecode y cachés de herramientas Python (clase temporal) -------------
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- Entornos virtuales y variables locales (nunca en git) -----------------
.venv/
venv/
.env

# --- Artefacto de construcción de las GUI (lo regenera tools/build_resources.sh)
resources_rc.py

# --- Informes de ejecución y logs: rotan en cada corrida (§15.8) -----------
reports/
*.log

# --- Ajustes locales del asistente ---------------------------------------
.claude/

# DOC2 (2026-09-20): temporales y derivados fuera de git (NORMATIVA §5, §15.8)
reports/
scripts_filesystem_studio/backend/script_hardlinks-creator/archivos.txt
estructura.txt
